{
  "name": "html-to-figma",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:static-css": "tailwindcss -c ./tailwind.static.config.ts -i ./index.css -o ./public/static.css --minify",
    "build:sitemap": "node scripts/generate-sitemap.mjs",
    "build": "npm run build:static-css && npm run build:sitemap && vite build",
    "test:seo": "node scripts/seo-audit.mjs && node scripts/content-quality-audit.mjs",
    "test:e2e": "playwright test",
    "test:e2e:live": "PLAYWRIGHT_BASE_URL=https://html2design.com playwright test",
    "test": "npm run test:seo && npm run test:e2e",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist",
    "cf:dev": "wrangler pages dev ./dist"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.45.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.27",
    "fast-xml-parser": "^5.10.0",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "wrangler": "^4.111.0"
  }
}
